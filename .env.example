# Copy this file to .env and fill in the blanks.
#
#   cp .env.example .env
#
# Local Supabase stack defaults (from `supabase start`) are already filled in below.

# Printed by `supabase start` as "API URL". Same value locally and via `npm run db:start`.
SUPABASE_URL=http://127.0.0.1:54321

# Printed by `supabase start` as "anon key". Paste it in -- it changes every time you
# `supabase stop && supabase start` unless you keep the same local project.
SUPABASE_ANON_KEY=

# Printed by `supabase start` as "DB URL" (direct connection, not the pooler).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Used for embeddings (text-embedding-3-small) and the support agent's LLM (gpt-4o-mini).
OPENAI_API_KEY=

# Optional: override the agent's model. Defaults to openai/gpt-4o-mini.
# MASTRA_MODEL=openai/gpt-4o-mini
# To use Claude instead, set MASTRA_MODEL=anthropic/claude-sonnet-4-6 and ANTHROPIC_API_KEY.

# Port the Mastra dev server listens on.
MASTRA_PORT=4111

# --- Aneka voice assistant + owner WhatsApp notify ---
# Owner's WhatsApp number in E.164 (no +), e.g. 447700900123
ANEKA_OWNER_WHATSAPP_NUMBER=

# WhatsApp Cloud API (Meta). Leave unset / set DRY_RUN=true for local dry-run logging.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_PHONE_NUMBER_ID=   # alias accepted by the client
WHATSAPP_API_VERSION=v22.0
WHATSAPP_DRY_RUN=true

# Optional business profile overrides (defaults to Riverside Plumbing demo).
# ANEKA_BUSINESS_NAME=Riverside Plumbing
# ANEKA_OWNER_NAME=Sam Taylor
# ANEKA_TRADE_OR_BUSINESS_TYPE=plumbing and heating business

# LiveKit (required for realtime voice calls — browser or SIP/Twilio bridge).
# Create a project at https://cloud.livekit.io or run livekit-server --dev
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# LIVEKIT_AGENT_NAME=aneka-voice
# ANEKA_STT=deepgram/nova-3
# ANEKA_TTS=cartesia/sonic-3
